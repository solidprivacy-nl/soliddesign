# Never commit real credentials.
# Overture discovery needs no API key. Optional release pin for reproducible batches:
OVERTURE_RELEASE=
SUPABASE_URL=
# Prefer modern server-side secret keys for new Supabase projects.
SUPABASE_SECRET_KEY=
# Legacy compatibility only:
SUPABASE_SERVICE_ROLE_KEY=
PITCH_DOCTOR_COMMAND=pitch-doctor
# Optional future Google enrichment only; not required for canonical Phase-1 discovery.
GOOGLE_PLACES_API_KEY=
